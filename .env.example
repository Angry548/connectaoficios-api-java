# Solo desarrollo Docker local. Copiar a .env y completar antes de validar.
MYSQL_DATABASE=ConnectaOficios
MYSQL_USER=connectaoficios
MYSQL_PASSWORD=CAMBIAR_PASSWORD_MYSQL_LOCAL
MYSQL_ROOT_PASSWORD=CAMBIAR_PASSWORD_ROOT_LOCAL
# 3306 ya esta ocupado en Windows; Docker conserva 3306 internamente.
MYSQL_HOST_PORT=3307

# HS256: generar una clave local aleatoria de al menos 32 bytes.
JWT_SECRET=CAMBIAR_POR_CLAVE_ALEATORIA_LOCAL_DE_AL_MENOS_32_BYTES
# No hay valores de desarrollo definidos en el repositorio.
# Usar exactamente issuer y audience del emisor JWT local.
JWT_ISSUER=
JWT_AUDIENCE=

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Formato obligatorio: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Usar una cuenta de desarrollo para funciones de imagen, nunca produccion.
CLOUDINARY_URL=
