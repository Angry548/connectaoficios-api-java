{
  "info": {
    "name": "ConnectaOficios Java - integración LOCAL",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Solo Docker local. Seed aplicado y perfil trabajador existente, cuentas/tokens de .NET local. Genera datos de dominio; no crea cuentas ni realiza login."
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const base = pm.environment.get('baseUrl');",
          "if (!/^http:\\/\\/(localhost|127\\.0\\.0\\.1):8081$/.test(base || '')) throw new Error('Solo localhost:8081');",
          "const destino = pm.variables.replaceIn(pm.request.url.toString());",
          "if (!destino.startsWith(base + '/')) throw new Error('Destino fuera del entorno local');",
          "pm.variables.set('fechaFutura', new Date(Date.now()+86400000).toISOString().slice(0,10));",
          "pm.variables.set('runId', Date.now().toString());"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 OpenAPI",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "noauth"
        },
        "url": "{{baseUrl}}/v3/api-docs"
      },
      "protocolProfileBehavior": {
        "followRedirects": false
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Tiempo < 5 s', () => pm.expect(pm.response.responseTime).to.be.below(5000));",
              "pm.test('JSON', () => pm.response.to.be.json);",
              "pm.test('Campo openapi', () => pm.expect(pm.response.json()).to.have.property('openapi'));"
            ]
          }
        }
      ]
    },
